---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const posts = (await getCollection('writeups')).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

// 2. Crear un objeto para agrupar los posts por el campo 'ctf'
const groupedByCtf = posts.reduce((acc: Record<string, typeof posts>, post) => {
    // Usamos 'post.data.ctf' como clave (o una clave por defecto si falta)
    const ctfName = post.data.ctf || 'Sin Categoría'; 
    if (!acc[ctfName]) {
        acc[ctfName] = [];
    }
    acc[ctfName].push(post);
    return acc;
}, {});

const ctfNames = Object.keys(groupedByCtf); // Opcional: ordenar por nombre de CTF
---

<!doctype html>
<html lang="en">
    <head>
        <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    </head>
    <body>
        <Header />
        
        <main class="max-w-4xl mx-auto px-4 mt-8 min-h-screen">
            <h1 class="text-3xl font-bold font-sans mb-8">Todos los Writeups</h1>
            <section class="space-y-8">

                                {ctfNames.map((ctfName) => (
                    <div class="border border-gray-200 rounded-lg p-4 shadow-sm">
                        
                                                <h2 class="text-2xl font-bold font-sans mb-4 -flex items-center">
                            <span class="mr-2"></span> {ctfName}
                        </h2>
                        
                                                <div class="pl-6 border-l-2 border-dashed border-gray-300 space-y-2">
                            
                                                        {groupedByCtf[ctfName].map((post) => (
                                <a 
                                    href={`/writeups/${post.id}/`} 
                                    class="block p-3 bg-white rounded-md hover:bg-gray-50 transition duration-150 ease-in-out group relative"
                                >
                                                                        <div class="absolute left-[-1.6rem] top-1/2 -translate-y-1/2 w-6 h-0.5 bg-gray-300"></div>

                                    <article class="flex justify-between items-start">
                                        <div class="flex-grow pr-4 flex items-center">
                                            <span class="mr-2 text-gray-500"></span>
                                            <div>
                                                <h3 class="text-lg font-medium font-sans group-hover:text-blue-600 transition">
                                                    {post.data.title}
                                                </h3>
                                                <p class="text-gray-500 mt-0.5 text-xs font-serif hidden sm:block">
                                                    {post.data.description}
                                                </p>
                                            </div>
                                        </div>
                                        
                                        <time class="text-xs text-gray-400 font-sans mt-0.5 whitespace-nowrap">
                                            <FormattedDate date={post.data.pubDate} />
                                        </time>
                                    </article>
                                </a>
                            ))}
                        </div>
                    </div>
                ))} 
            </section> 
        </main>
        <Footer />
    </body>
</html>