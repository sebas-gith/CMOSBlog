---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const posts = (await getCollection('writeups')).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="en">
    <head>
        <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
            </head>
    <body>
        <Header />
        
                <main class="max-w-4xl mx-auto px-4 mt-8 min-h-screen">
            <h1 class="text-3xl font-bold font-sans mb-8">Todos los Writeups</h1>
          <section class="space-y-6">
              {
                    posts.map((post) => (
                        <a 
                            href={`/writeups/${post.id}/`} 
                            class="block p-4 rounded-lg shadow-md mb-4 hover:shadow-lg hover:bg-gray-50 transition duration-150 ease-in-out group"
                        >
                            <article class="flex justify-between items-start">
                                <div class="flex-grow pr-4">
                                                                        <h2 class="text-xl font-semibold font-sans group-hover:text-blue-600 transition">
                                        {post.data.title}
                                    </h2>
                                                                        <p class="text-gray-600 mt-1 text-sm font-serif">
                                        {post.data.description}
                                    </p>
                                </div>
                                
                                                                <time class="text-sm text-gray-400 font-sans mt-0.5 whitespace-nowrap">
                                    <FormattedDate date={post.data.pubDate} />
                                </time>
                            </article>
                        </a>
                    ))
                } 
            </section> 
        </main>
        <Footer />
    </body>
</html>