---
import { getCollection } from 'astro:content';
// Asegúrate de que las rutas a tus componentes sean correctas
import BaseHead from '../components/BaseHead.astro'; 
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

// Obtenemos todos los posts y los ordenamos por fecha (el más nuevo primero)
const allPosts = (await getCollection('blog')).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const allWriteups = (await getCollection('writeups')).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

// Separamos el post más reciente para destacarlo
const featuredPost = allPosts[0];
const featuredWriteups = allWriteups[0];
const otherPosts = allPosts.slice(1);
const otherWriteups = allPosts.slice(1);
---

<!doctype html>
<html lang="es">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body class="bg-white text-gray-800 min-h-screen">
		<Header />
		
		<main class="max-w-4xl mx-auto px-4 py-12">

            {featuredPost && (
                <section class="mb-1 border-b border-gray-100 pb-12">
                    <h2 class="text-3xl sm:text-3xl font-extrabold font-sans mb-6 tracking-tight">
                        Último blog 
                    </h2>
                    
                    <a href={`/blog/${featuredPost.id}/`} class="block p-6 bg-gray-50 hover:bg-gray-100 transition duration-300 rounded-xl shadow-lg hover:shadow-xl">
                        <article>
                            <div class="flex flex-col md:flex-row md:items-start">
                                <!-- Contenido del Post Destacado -->
                                <div class="md:w-3/4 pr-0 md:pr-8">
                                    <h2 class="text-2xl font-extrabold font-sans text-gray-900 mb-2 group-hover:text-blue-700">
                                        {featuredPost.data.title}
                                    </h2>
                                    <p class="text-lg text-gray-600 font-serif mb-4">
                                        {featuredPost.data.description}
                                    </p>
                                    <span class="text-sm text-blue-600 font-semibold inline-block mt-2">
                                        Leer Blog &rarr;
                                    </span>
                                </div>
                                
                                <!-- Metadatos a la Derecha -->
                                <div class="md:w-1/4 mt-4 md:mt-0 md:pt-1 md:text-right">
                                    <p class="text-xs font-semibold text-gray-400 uppercase tracking-wider">
                                        Publicado
                                    </p>
                                    <p class="text-sm text-gray-600 font-sans">
                                        <FormattedDate date={featuredPost.data.pubDate} />
                                    </p>
                                </div>
                            </div>
                        </article>
                    </a>
                </section>
            )}
			
			 {featuredWriteups && (
                <section class="mb-16 border-b border-gray-100 pb-12">
                    <h2 class="text-3xl sm:text-3xl font-extrabold font-sans mb-6 tracking-tight">
                        Último Writeup
                    </h2>
                    
                    <a href={`/writeups/${featuredWriteups.id}/`} class="block p-6 bg-gray-50 hover:bg-gray-100 transition duration-300 rounded-xl shadow-lg hover:shadow-xl">
                        <article>
                            <div class="flex flex-col md:flex-row md:items-start">
                                <!-- Contenido del Post Destacado -->
                                <div class="md:w-3/4 pr-0 md:pr-8">
                                    <h2 class="text-2xl font-extrabold font-sans text-gray-900 mb-2 group-hover:text-blue-700">
                                        {featuredWriteups.data.title}
                                    </h2>
                                    <p class="text-lg text-gray-600 font-serif mb-4">
                                        {featuredWriteups.data.description}
                                    </p>
                                    <span class="text-sm text-blue-600 font-semibold inline-block mt-2">
                                        Leer Writeup &rarr;
                                    </span>
                                </div>
                                
                                <!-- Metadatos a la Derecha -->
                                <div class="md:w-1/4 mt-4 md:mt-0 md:pt-1 md:text-right">
                                    <p class="text-xs font-semibold text-gray-400 uppercase tracking-wider">
                                        Publicado
                                    </p>
                                    <p class="text-sm text-gray-600 font-sans">
                                        <FormattedDate date={featuredWriteups.data.pubDate} />
                                    </p>
                                </div>
                            </div>
                        </article>
                    </a>
                </section>
            )}
    

		</main>
		
		<Footer />
	</body>
</html>