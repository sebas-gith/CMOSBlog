---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
import ThemeToggle from './ThemeToggle.astro';
---

<header>
	<nav>
		<h2><a href="/">{SITE_TITLE}</a></h2>
		<div class="internal-links">
			<HeaderLink href="/">Inicio</HeaderLink>
			<HeaderLink href="/blog">Blog</HeaderLink>
			<HeaderLink href="/writeups">Writeup</HeaderLink>
			<HeaderLink href="/about">Sobre Mí</HeaderLink>
			<HeaderLink href="/codes">Código</HeaderLink>
		</div>
		
		<div class="controls">
			<div class="social-links">
				<a href="https://www.linkedin.com/in/sebastian-g-alvarez-c/" target="_blank">
	                <span class="sr-only">Go to CMOS' LinkedIn profile</span>
	                <svg
	                    xmlns="http://www.w3.org/2000/svg"
	                    width="32"
	                    height="32"
	                    viewBox="0 0 24 24"
	                    fill="currentColor"
	                >
	                    <path
	                        d="M20.447 20.452h-3.554v-5.569c0-1.35.016-3.084-1.875-3.084-1.879 0-2.167 1.472-2.167 2.997v5.656h-3.554V9.29h3.414v1.579h.046c.475-.845 1.638-1.737 3.364-1.737 3.606 0 4.27 2.368 4.27 5.44V20.452zM4.337 7.214a2.845 2.845 0 0 1-2.848-2.845 2.844 2.844 0 0 1 2.848-2.847 2.847 2.847 0 0 1 2.846 2.847 2.845 2.845 0 0 1-2.846 2.845zm-.008 13.238H7.88V9.29H4.329v11.162z"
	                    ></path>
	                </svg>
	            </a>
				<a href="https://github.com/sebas-gith" target="_blank">
					<span class="sr-only">Go to CMOS' GitHub repo</span>
					<svg viewBox="0 0 16 16" aria-hidden="true" width="32" height="32"
						><path
							fill="currentColor"
							d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
						></path></svg
					>
				</a>
			</div>
			<ThemeToggle />
		</div>
	</nav>
</header>
<style>
	header {
		margin: 0;
		padding: 0 1em;
		background: var(--bg-primary);
		box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
		transition: background-color 0.3s ease, box-shadow 0.3s ease;
		border-bottom: 1px solid var(--border-color);
		position: relative;
		z-index: 50;
	}
	h2 {
		margin: 0;
		font-size: 1em;
		color: var(--text-primary);
	}

	h2 a,
	h2 a.active {
		text-decoration: none;
		color: var(--accent);
		transition: color 0.3s ease;
	}

	h2 a:hover {
		opacity: 0.8;
	}

	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1em;
		flex-wrap: wrap;
	}

	nav a {
		padding: 1em 0.5em;
		color: var(--text-secondary);
		border-bottom: 4px solid transparent;
		text-decoration: none;
		transition: all 0.3s ease;
	}

	nav a:hover {
		color: var(--accent);
		border-bottom-color: var(--accent);
	}

	nav a.active {
		color: var(--accent);
		border-bottom-color: var(--accent);
	}

	.internal-links {
		display: flex;
		gap: 0.5em;
		flex-wrap: wrap;
	}

	.controls {
		display: flex;
		align-items: center;
		gap: 1em;
	}

	.social-links {
		display: flex;
		gap: 0.5em;
	}

	.social-links a {
		display: flex;
		align-items: center;
		color: var(--text-secondary);
		transition: color 0.3s ease;
		text-decoration: none;
	}

	.social-links a:hover {
		color: var(--accent);
	}

	@media (max-width: 900px) {
		nav {
			flex-wrap: wrap;
		}
	}

	@media (max-width: 700px) {
		header {
			padding: 0.5em 1em;
		}

		nav {
			flex-wrap: wrap;
			gap: 0.5em;
		}

		h2 {
			width: 100%;
			order: 1;
		}

		.internal-links {
			order: 3;
			width: 100%;
			gap: 0.25em;
		}

		.controls {
			order: 2;
			gap: 0.5em;
		}

		.social-links {
			display: none;
		}

		nav a {
			padding: 0.75em 0.25em;
			font-size: 0.9em;
		}
	}
</style>
